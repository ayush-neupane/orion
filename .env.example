# ============================================================
# ORION - Environment Configuration (TEMPLATE)
# Copy to `.env` and adjust. NEVER commit a real .env file.
# The application boots with ONLY the core section filled in.
# All external-provider keys are OPTIONAL free tiers.
# ============================================================

# ---- Core ----
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ---- Database (PostgreSQL + TimescaleDB) ----
POSTGRES_USER=orion
POSTGRES_PASSWORD=orion_local_dev_pw
POSTGRES_DB=orion
DATABASE_URL=postgresql+psycopg2://orion:orion_local_dev_pw@postgres:5432/orion

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
RATELIMIT_STORAGE_URI=memory://

# ---- Ingestion / Runtime tuning ----
INGEST_INTERVAL_SECONDS=60
NEWS_REFRESH_MINUTES=30
PREDICTION_REFRESH_MINUTES=10
MAX_WS_MESSAGE_BYTES=1048576
LOG_LEVEL=INFO
LOG_FILE=logs/orion.log
# Secure flag on the refresh cookie. Keep `true` behind TLS; set to `false`
# ONLY for plain-HTTP local development (browsers reject Secure cookies on
# non-localhost HTTP).
COOKIE_SECURE=true

# ---- OPTIONAL external providers (all free tiers, app works without them) ----
ALPHA_VANTAGE_KEY=
NEWS_API_KEY=
PROXY_URL=

# ---- Frontend (Vite dev server only; production uses nginx) ----
VITE_API_BASE=/api

# ---- OPTIONAL analytics (100% free & opt-in; NO third-party requests unless set) ----
# Point VITE_ANALYTICS_SRC at a self-hosted Umami script (free), a GoatCounter
# script (free for non-commercial), or any privacy-friendly analytics endpoint.
# VITE_ANALYTICS_SRC=http://localhost:3001/umami.js   (example: self-hosted Umami)
# VITE_ANALYTICS_DOMAIN=localhost:8080